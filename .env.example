# 复制为 .env 后填写。.env 不要提交到 git。

# PostgreSQL
POSTGRES_DB=flight_analysis
POSTGRES_USER=flight
POSTGRES_PASSWORD=change-me

# DeepSeek：接口地址与模型 ID 必须自行填写（代码中不设默认值）
# 如经代理访问，DEEPSEEK_BASE_URL 填代理地址（需兼容 OpenAI 接口，末尾通常为 /v1）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
AGENT_MODEL=
WORKFLOW_MODEL=

# 出站代理（可选，不需要则留空）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db,backend

# 应用
WEB_PORT=9092
# 数据库映射到宿主机的端口，用于外部工具直连（请勿暴露到公网）
DB_PORT=9095
RUN_MIGRATIONS_ON_START=true
LOG_LEVEL=INFO

# 镜像（部署脚本使用）
IMAGE_REGISTRY=ghcr.io/junleo1945
IMAGE_TAG=latest
# 私有镜像拉取凭据（可选，使用只读 PAT）
GHCR_USER=
GHCR_TOKEN=
